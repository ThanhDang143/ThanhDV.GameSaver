            +GetAllProfileIds() IEnumerable~string~
            +GetMostRecentProfileId() string
        }

        class IEncryptionProvider {
            <<interface>>
            +Encrypt(string plainText) string
            +Decrypt(string cipherText) string
        }

        class SaveSettings {
            <<ScriptableObject>>
            +bool CreateProfileIfNull
            +bool UseEncryption
            +string FileName
            +string SaveExtension
            +string MetaExtension
            +bool EnableAutoSave
            +float AutoSaveTime
        }

        class SaveData {
            +Dictionary~string, ISaveData~ ObjectData
            +GetData~T~(string customKey = null) T
            +SetData~T~(T data, string customKey = null) void
            +RemoveData~T~(string customKey = null) void
        }

        class SaveRegistry {
            -HashSet~ISavable~ _savables
            +IEnumerable~ISavable~ Savables
            +Action~ISavable~ OnSavableRegistered
            +Action~ISavable~ OnSavableUnregistered
            +Register(ISavable savable) void
            +Unregister(ISavable savable) void
        }

        class GameSaver {
            -SaveRegistry _registry
            -IStorageProvider _storageProvider
            -ISerializer _serializer
            -IEncryptionProvider _encryptionProvider
            -SaveSettings _settings
            -SaveData _curSaveData
            -string _curProfileId
            -string MetaName
            -string SaveName
            +GameSaver(SaveRegistry registry, IStorageProvider storageProvider, ISerializer serializer, IEncryptionProvider encryptionProvider, SaveSettings settings)
            +GetAllMetadataAsync~T~() GameSaverOperationHandle~List<T>~
            +GetMostRecentProfileId() string
            +GetAllProfiles() IEnumerable~string~
            +DeleteProfile(string profileId) void
            +SaveAsync(string profileId = null, ISaveMeta metadata = null) GameSaverOperationHandle
            +SaveImmediate(string profileId = null, ISaveMeta metadata = null) void
            +RestoreBackup(string profileId) void
            +LoadAsync(string profileId) GameSaverOperationHandle
            +LoadBackupAsync(string profileId) GameSaverOperationHandle
            +LoadMostRecentAsync() GameSaverOperationHandle
            +Dispose() void
        }
    }

    %% --- OPERATION ---
    namespace Operation {
        class GameSaverOperationStatus {
            <<enumeration>>
            Pending
            Succeeded
            Failed
        }

        class GameSaverOperationHandle {
            +bool IsDone
            +GameSaverOperationStatus Status
            +float PercentComplete
            +Exception Error
            +Action~GameSaverOperationHandle~ Completed
            +GetAwaiter() GameSaverAwaiter
        }

        class GameSaverOperationHandle~T~ {
            +bool IsDone
            +GameSaverOperationStatus Status
            +float PercentComplete
            +Exception Error
            +T Result
            +Action~GameSaverOperationHandle~T~~ Completed
            +GetAwaiter() GameSaverAwaiter~T~
        }

        class GameSaverAwaiter {
            +bool IsCompleted
            +OnCompleted(Action continuation) void
            +GetResult() void
        }

        class GameSaverAwaiter~T~ {
            +bool IsCompleted
            +OnCompleted(Action continuation) void
            +GetResult() T
        }

        class GameSaverOperationInternal {
            -GameSaverOperationStatus Status
            -float PercentComplete
            -Exception Error
            -bool IsDone
            -Action~GameSaverOperationHandle~ Completed
            -Action ContinuationAction
            +Complete(Exception error = null) void
        }

        class GameSaverOperationInternal~T~ {
            -GameSaverOperationStatus Status
            -float PercentComplete
            -Exception Error
            -T Result
            -bool IsDone
            -Action~GameSaverOperationHandle~T~~ Completed
            -Action ContinuationAction
            +Complete(T result, Exception error = null) void
        }
    }

