classDiagram
    %% --- CORE ---
    namespace Core {
        class ISavable {
            <<interface>>
            +string SaveKey
            +CaptureData() ISaveData
            +RestoreData(ISaveData data)
        }

        class ISaveData {
            <<interface>>
        }

        class ISaveMeta {
            <<interface>>
            +string ProfileID
            +DateTime LastTimeSaved
        }

        class ISerializer {
            <<interface>>
            +Serialize~T~(T obj) string
            +Deserialize~T~(string data) T
        }

        class IStorageProvider {
            <<interface>>
            +WriteAsync(string profileId, string fileName, string data) Task
            +WriteImmediate(string profileId, string fileName, string data) void
            +RestoreBackup(string profileId, string fileName) void
            +ReadAsync(string profileId, string fileName) Task~string~
            +ReadBackupAsync(string profileId, string fileName) Task~string~
            +DeleteProfile(string profileId) void
            +Exists(string profileId, string fileName) bool
            +GetAllProfileIds() IEnumerable~string~
            +GetMostRecentProfileId() string
        }

        class IEncryptionProvider {
            <<interface>>
            +Encrypt(string plainText) string
            +Decrypt(string cipherText) string
        }

        class SaveSettings {
            <<ScriptableObject>>
            +bool CreateProfileIfNull
            +bool UseEncryption
            +bool SaveAsSeparateFiles
            +string FileName
            +string FileExtension
            +bool EnableAutoSave
            +float AutoSaveTime
        }

        class SaveData {
            +Dictionary~string, ISaveData~ DataModules
            +GetData~T~(string customKey) T
            +SetData~T~(T data, string customKey) void
            +RemoveData~T~(string customKey) void
        }

        class SaveRegistry {
            -HashSet~ISavable~ _savables
            +IEnumerable~ISavable~ Savables
            +Action~ISavable~ OnSavableRegistered
            +Action~ISavable~ OnSavableUnregistered
            +Register(ISavable savable) void
            +Unregister(ISavable savable) void
        }

        class GameSaver {
            -SaveRegistry _registry
            -IStorageProvider _storageProvider
            -ISerializer _serializer
            -IEncryptionProvider _encryptionProvider
            -SaveSettings _settings
            -SaveData _curSaveData
            -string _curProfileId
            +GameSaver(SaveRegistry registry, IStorageProvider storageProvider, ISerializer serializer, IEncryptionProvider encryptionProvider, SaveSettings settings)
            +GetMostRecentProfileId() string
            +GetAllProfiles() IEnumerable~string~
            +DeleteProfile(string profileId) void
            +SaveAsync(string profileId) GameSaverOperationHandle
            +SaveImmediate(string profileId) void
            +RestoreBackup(string profileId) void
            +LoadAsync(string profileId) GameSaverOperationHandle
            +LoadBackupAsync(string profileId) GameSaverOperationHandle
            +LoadMostRecentAsync() GameSaverOperationHandle
            +Dispose() void
        }
    }

    %% --- ASYNC OPERATION ---
    namespace Operation {
        class GameSaverOperationStatus {
            <<enumeration>>
            Pending
            Succeeded
            Failed
        }

        class GameSaverOperationHandle {
            +bool IsDone
            +GameSaverOperationStatus Status
            +float PercentComplete
            +Exception Error
            +Action~GameSaverOperationHandle~ Completed
            +GetAwaiter() GameSaverAwaiter
        }

        class GameSaverAwaiter {
            +bool IsCompleted
            +OnCompleted(Action continuation) void
            +GetResult() void
        }

        class GameSaverOperationInternal {
            -GameSaverOperationStatus Status
            -float PercentComplete
            -Exception Error
            -bool IsDone
            -Action~GameSaverOperationHandle~ Completed
            -Action ContinuationAction
            +Complete(Exception error) void
        }
    }

