    %% --- RELATIONSHIPS ---
    SaveRegistry "1" *-- "*" ISavable : tracks
    SaveData o-- ISaveData : stores object
    ISavable ..> ISaveData : capture/restore
    CustomSaveData ..|> ISaveData : implements
    CustomSaveMeta ..|> ISaveMeta : implements

    GameSaver --> SaveData : owns active state
    GameSaver ..> SaveRegistry : subscribes to events
    GameSaver ..> IStorageProvider : persists files
    GameSaver ..> ISerializer : serializes payloads
    GameSaver ..> IEncryptionProvider : encrypts save data
    GameSaver ..> SaveSettings : reads configuration
    GameSaver ..> ISaveMeta : updates metadata on save

    JsonSerializer ..|> ISerializer : implements
    LocalStorageProvider ..|> IStorageProvider : implements
    AESProvider ..|> IEncryptionProvider : implements

    GameSaver --> GameSaverOperationHandle : returns
    GameSaver --> GameSaverOperationHandle~T~ : returns
    GameSaverOperationHandle ..> GameSaverAwaiter : awaitable via
    GameSaverOperationHandle~T~ ..> GameSaverAwaiter~T~ : awaitable via
    GameSaverOperationHandle ..> GameSaverOperationInternal : wraps
    GameSaverOperationHandle~T~ ..> GameSaverOperationInternal~T~ : wraps
    GameSaverOperationInternal --> GameSaverOperationStatus : tracks
    GameSaverOperationInternal~T~ --> GameSaverOperationStatus : tracks