    %% RELATIONSHIPS
    SaveRegistry "1" *-- "*" ISavable : tracks
    GameSaver ..> SaveRegistry : subscribes to
    GameSaver ..> IStorageProvider : uses
    GameSaver ..> ISerializer : uses
    GameSaver ..> IEncryptionProvider : uses
    GameSaver ..> SaveSettings : uses
    GameSaver --> SaveData : owns active state
    GameSaver --> GameSaverOperationHandle : returns
    SaveData o-- ISaveData : stores modules
    ISavable ..> ISaveData : capture/restore
    ISavable ..> SaveData : keyed by SaveKey
    CustomSaveData ..|> ISaveData : implements

    JsonSerializer ..|> ISerializer : implements
    LocalStorageProvider ..|> IStorageProvider : implements
    AESProvider ..|> IEncryptionProvider : implements

    GameSaverOperationHandle ..> GameSaverAwaiter : awaitable via
    GameSaverOperationHandle ..> GameSaverOperationInternal : wraps
    GameSaverOperationInternal --> GameSaverOperationStatus : tracks